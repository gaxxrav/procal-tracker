# Supabase project credentials.
# Dashboard -> your project -> Settings -> API
#
# Both values are safe to expose in the browser: the anon key only grants what
# your Row Level Security policies allow. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio key for the Quick log parser (aistudio.google.com/apikey).
# Server-side only — deliberately NOT VITE_ prefixed, so it is never bundled
# into browser code. Only /api/parse reads it.
# Optional: GEMINI_MODEL overrides the default Flash model.
GEMINI_API_KEY=your-google-ai-studio-key
